                ");\n");
+    // A Rust crate linked into the program (Ferrous Goose 0005) gets the
+    // runtime's hooks as a library an extern block opens does: the
+    // program's own, or a package's whose functions it calls.
+    auto cargo = !ast.packages.empty() && !ast.packages[0].cargo_staticlib.empty();
+    for (auto sp : usedexterns) {
+        if (!sp->sf->dylib.empty()) continue;
+        auto pkg = ast.filepkg[sp->sf->line.fileidx];
+        cargo = cargo || !ast.packages[pkg].cargo_staticlib.empty() || ast.packages[pkg].cargo_owner >= 0;
+    }
+    if (cargo) {
+        Append(data, "void goose_runtime_hooks(const gs_rt_hooks *);\n");
+        Append(code, "    gs_rt_give_hooks(goose_runtime_hooks);\n");
+    }
     // The queues, before anything that could use one runs.
     vector<string> qnames;
     for (auto &[m, q] : queues) qnames.push_back(q);
