+    if (!p.cargo_staticlib.empty() &&
+        std::find(externs.begin(), externs.end(), "goose_runtime_hooks") == externs.end())
+        externs.push_back("goose_runtime_hooks");
     string externtext;
     for (auto &n : externs) Append(externtext, n, "\n");
     // The stamp: what the build was made from, then whether it holds the
@@ -514,6 +527,35 @@ inline bool BuildNativePart(const Ast &ast, int pkg, const string &rootfile,
         if (!b.opts.dryrun) WriteFileIfChanged(stampfile, wantjit ? jitstamp : aotstamp);
         return true;
     }
+    if (!p.cargo_staticlib.empty()) {
+        // The crate's static library and the system libraries rustc says it
+        // needs, as a link takes them.
+        auto msvcstyle = b.tc.style == "msvc";
+        string rsp;
+        Append(rsp, msvcstyle ? "" : "\"", p.cargo_staticlib, msvcstyle ? "" : "\"", "\n");
+        for (auto &l : p.cargo_native_libs) Append(rsp, l, "\n");
+        if (!b.opts.dryrun && !WriteFileIfChanged(out.rsp, rsp))
+            throw CompileError { cat("cannot write ", out.rsp) };
+        if (wantjit) {
+            auto symsrc = cat(dir, "/goose_symbols.c");
+            auto symobj = cat(dir, msvcstyle ? "/goose_symbols.obj" : "/goose_symbols.o");
+            if (!b.opts.dryrun && !WriteFileMakingDirs(symsrc, SymbolTableSource(p.name, externs)))
+                throw CompileError { cat("cannot write ", symsrc) };
+            vector<string> symflags = { msvcstyle ? "/w" : "-w" };
+            #ifndef _WIN32
+                if (!msvcstyle) symflags.push_back("-fPIC");
+            #endif
+            if (!b.CompileObject(symsrc, symobj, cat("compiling the symbol table of the package ", p.name),
+                                 cat(dir, "/goose_symbols.cc.log"), symflags))
+                return false;
+            if (!b.LinkShared({ symobj, p.cargo_staticlib }, p.cargo_native_libs, out.jitlib, dir,
+                              cat(dir, "/jit.cc.log"),
+                              cat("building the package ", p.name, "'s library for the JIT")))
