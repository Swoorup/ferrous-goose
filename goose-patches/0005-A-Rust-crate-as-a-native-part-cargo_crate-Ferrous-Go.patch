index 00000000..efbafdc2
--- /dev/null
+++ b/src/cargo.h
@@ -0,0 +1,141 @@
+// Goose compiler — a Rust crate as a package's native part (Ferrous Goose
+// 0005): the sidecar's `cargo_crate = "dir";` names a crate using Ferrous
+// Goose's #[goose::export], and `cargo goose native` builds it, writes the
+// Goose module for its exports beside the sidecar and says where its static
+// library is. A build links that library as it links a package's C, a run
+// builds the JIT library from it, and both run the crate's build again
+// whenever the program is compiled, which Cargo makes cheap when nothing
+// changed.
+#pragma once
+
+namespace goose {
+
+// Whether loading a sidecar may run Cargo: the compiling verbs say so, the
+// language server does not (it reads the module the last build wrote).
+inline bool &CargoBuildsAllowed() {
+    static bool allowed = false;
+    return allowed;
+}
+
+// The compiler's own path, which cargo goose asks what it can do.
+inline string &GooseExePath() {
+    static string exe;
+    return exe;
+}
+
+// How cargo goose is run: $GOOSE_CARGO_GOOSE, a cargo-goose binary, or
+// `cargo goose` with the subcommand on PATH.
+inline vector<string> CargoGooseCommand() {
+    if (auto e = getenv("GOOSE_CARGO_GOOSE"); e && *e) return { e };
+    auto direct = FindOnPath("cargo-goose");
+    if (!direct.empty()) return { direct };
+    auto cargo = FindOnPath("cargo");
+    if (cargo.empty()) return {};
+    return { cargo, "goose" };
+}
+
+// Builds the package's crate, when its sidecar names one, and records what
+// the build made. The module lands in the package's root; a package fetched
+// from git builds under GOOSE_HOME rather than in its checkout's target/.
+inline void BuildCargoCrate(Package &pkg) {
+    if (pkg.cargo_crate.empty() || !CargoBuildsAllowed()) return;
+    auto cmd = CargoGooseCommand();
+    if (cmd.empty())
+        throw CompileError { cat(pkg.sidecar, ": cargo_crate needs Cargo and cargo-goose (cargo install "
+                                 "cargo-goose), and neither cargo-goose nor cargo is on PATH") };
+    auto manifest = cat(pkg.cargo_crate, "/Cargo.toml");
+    if (!PathExists(manifest))
+        throw CompileError { cat(pkg.sidecar, ": cargo_crate names ", pkg.cargo_crate,
+                                 ", which has no Cargo.toml") };
+    auto outdir = pkg.root.empty() ? string(".") : pkg.root;
+    vector<string> argv = cmd;
+    for (auto &a : vector<string> { "native", "--manifest-path", manifest, "--out-dir", outdir })
+        argv.push_back(a);
+    if (!pkg.cargo_features.empty()) {
+        string f;
+        for (auto &x : pkg.cargo_features) Append(f, f.empty() ? "" : ",", x);
+        argv.push_back("--features");
+        argv.push_back(f);
+    }
+    if (!pkg.cachekey.empty()) {
+        argv.push_back("--target-dir");
+        argv.push_back(cat(GooseHome(), "/build/cargo/", pkg.cachekey));
+    }
+    if (!GooseExePath().empty()) {
+        argv.push_back("--goose");
+        argv.push_back(GooseExePath());
+    }
+    ProgressStep step(cat("building the package ", pkg.name, "'s crate with Cargo"), true);
+    auto r = RunProcess(argv);
+    if (!r.started || r.code != 0)
+        throw CompileError { cat(pkg.sidecar, ": building the crate ", pkg.cargo_crate,
+                                 " failed:\n", r.output) };
+    // The last line holding the report is what cargo goose printed.
+    auto at = r.output.rfind("goose-native: ");
+    if (at == string::npos)
+        throw CompileError { cat(pkg.sidecar, ": cargo goose native printed no report:\n", r.output) };
+    auto line = r.output.substr(at + 14);
+    line = line.substr(0, line.find('\n'));
+    auto j = ParseJson(line);
+    pkg.cargo_staticlib = j.Str("staticlib");
+    pkg.cargo_module = j.Str("module");
+    pkg.cargo_native_libs.clear();
+    if (auto libs = j.Get("native_libs"))
+        for (auto &l : libs->arr) pkg.cargo_native_libs.push_back(l.str);
+}
+
+// Several crates in one program link as one static library: two would each
+// carry Rust's standard library and define its symbols twice. cargo goose
+// combine builds an umbrella crate depending on every one; the first
+// package's native part becomes that library, and the others' functions
+// are found in it (cargo_owner).
+inline void CombineCargoCrates(Ast &ast) {
+    vector<int> pkgs;
+    for (size_t i = 0; i < ast.packages.size(); i++)
+        if (!ast.packages[i].cargo_staticlib.empty()) pkgs.push_back((int)i);
+    if (pkgs.size() < 2 || !CargoBuildsAllowed()) return;
+    auto cmd = CargoGooseCommand();
+    string key;
+    vector<string> crates;
+    for (auto i : pkgs) {
+        auto &p = ast.packages[i];
+        string c = p.cargo_crate;
+        if (!p.cargo_features.empty()) {
+            c += ":";
+            for (size_t f = 0; f < p.cargo_features.size(); f++)
+                Append(c, f ? "," : "", p.cargo_features[f]);
+        }
+        crates.push_back(c);
+        Append(key, c, "\n");
+    }
+    auto outdir = cat(GooseHome(), "/build/cargo/combined-", Hex8(key));
+    vector<string> argv = cmd;
+    argv.push_back("combine");
+    argv.push_back("--out-dir");
+    argv.push_back(outdir);
+    for (auto &c : crates) {
+        argv.push_back("--crate");
+        argv.push_back(c);
+    }
+    ProgressStep step(cat("linking ", pkgs.size(), " crates as one library with Cargo"), true);
+    auto r = RunProcess(argv);
+    if (!r.started || r.code != 0)
+        throw CompileError { cat("combining the program's crates failed:\n", r.output) };
+    auto at = r.output.rfind("goose-native: ");
+    if (at == string::npos)
+        throw CompileError { cat("cargo goose combine printed no report:\n", r.output) };
+    auto line = r.output.substr(at + 14);
+    line = line.substr(0, line.find('\n'));
+    auto j = ParseJson(line);
+    auto &owner = ast.packages[pkgs[0]];
+    owner.cargo_staticlib = j.Str("staticlib");
+    owner.cargo_native_libs.clear();
+    if (auto libs = j.Get("native_libs"))
+        for (auto &l : libs->arr) owner.cargo_native_libs.push_back(l.str);
+    for (size_t k = 1; k < pkgs.size(); k++) {
+        ast.packages[pkgs[k]].cargo_owner = pkgs[0];
+        ast.packages[pkgs[k]].cargo_staticlib.clear();
+    }
+}
+
+}  // namespace goose
