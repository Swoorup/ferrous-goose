diff --git a/test/interface_json.py b/test/interface_json.py
new file mode 100644
index 00000000..ab78c03f
--- /dev/null
+++ b/test/interface_json.py
@@ -0,0 +1,54 @@
+"""Check the public interface schema, nested type discovery and JSON escaping."""
+import json
+from pathlib import Path
+import subprocess
+import sys
+import tempfile
+
+SOURCE = '''namespace probe;
+// A "leaf" with a backslash \\ and unicode λ.
+struct Leaf { x: i16, y: u8 }
+enum Choice { Value { payload: Leaf[2] }, Empty }
+struct Root { choice: Choice }
+export "inspect_root" fn inspect(root: const Root&) -> const u8[:] { return "ok"; }
+export fn fill(n: i64, out: i64[>..]&) -> i64, bool { return n, true; }
+'''
+
+
+def check_interface_json(exe, base=None):
+    with tempfile.TemporaryDirectory(prefix="interface schema ", dir=base) as tmp:
+        source = Path(tmp) / "schema.goose"
+        source.write_text(SOURCE, encoding="utf-8")
+        result = subprocess.run([str(exe), "check", "--emit-interface", "json", str(source)],
+                                capture_output=True, text=True, encoding="utf-8", timeout=60)
+        if result.returncode:
+            raise RuntimeError(result.stdout + result.stderr)
+        data = json.loads(result.stdout)
+        assert data["format"] == 1 and len(data["sources"]) == 1
+        exports = {e["name"]: e for e in data["exports"]}
+        assert exports["inspect"]["symbol"] == "inspect_root"
+        assert exports["inspect"]["params"][0]["type"] == {
+            "ref": {"to": {"struct": "probe::Root"}, "const": True}}
+        assert exports["fill"]["params"][1]["type"] == {"builder": {"elem": {"prim": "i64"}}}
+        assert [r["type"] for r in exports["fill"]["results"]] == [{"prim": "i64"}, {"prim": "bool"}]
+        structs = {s["name"]: s for s in data["structs"]}
+        assert set(structs) == {"Root", "Leaf"}
+        leaf = structs["Leaf"]
+        assert leaf["size"] == 3 and leaf["align"] == 1
+        assert '"leaf"' in leaf["doc"] and "\\" in leaf["doc"] and "λ" in leaf["doc"]
+        assert [(f["offset"], f["size"]) for f in leaf["fields"]] == [(0, 2), (2, 1)]
+        choice, = data["enums"]
+        assert choice["name"] == "Choice" and choice["tag_size"] == 1 and choice["size"] == 7
+        assert [v["tag"] for v in choice["variants"]] == [0, 1]
+        payload, = choice["variants"][0]["fields"]
+        assert payload["type"] == {"array": {"elem": {"struct": "probe::Leaf"}, "len": 2}}
+        assert payload["offset"] == 0 and payload["size"] == 6
+        assert structs["Root"]["size"] == 7
+
+
+if __name__ == "__main__":
+    compiler = Path(sys.argv[1]).resolve()
+    if not compiler.exists():
+        compiler = compiler.with_suffix(".exe")
+    check_interface_json(compiler)
+    print("interface JSON: nested layouts, builders, results and escaped docs passed")
