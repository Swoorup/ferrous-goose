diff --git a/src/interface.h b/src/interface.h
new file mode 100644
index 00000000..7e5dbbb8
--- /dev/null
+++ b/src/interface.h
@@ -0,0 +1,211 @@
+// The compiler-resolved C interface: exports and the layouts of the types
+// they reach. Binding generators use this JSON to build and check adapters.
+#pragma once
+
+namespace goose {
+
+struct InterfaceWriter {
+    CodeGen &cg;
+    Ast &ast;
+    vector<StructInst *> structs;
+    vector<EnumInst *> enums;
+    set<const void *> seen;
+
+    static void StringField(string &out, string_view key, string_view value) {
+        JsonQuote(out, key);
+        out += ':';
+        JsonQuote(out, value);
+    }
+
+    static void Names(string &out, string_view name, string_view qname) {
+        out += '{';
+        StringField(out, "name", name);
+        out += ',';
+        StringField(out, "qname", qname);
+    }
+
+    void Type(string &out, TypeExpr *t) {
+        switch (t->kind) {
+            case TY_INT:
+                Append(out, "{\"prim\":\"", IntStorageName(t->intstorage), "\"}");
+                return;
+            case TY_FLT:
+                Append(out, "{\"prim\":\"", t->fltstorage == FS_F32 ? "f32" : "f64", "\"}");
+                return;
+            case TY_BOOL:
+                out += "{\"prim\":\"bool\"}";
+                return;
+            case TY_STRUCT: {
+                auto si = cg.SI(t);
+                if (seen.insert(si).second) structs.push_back(si);
+                out += '{';
+                StringField(out, "struct", si->st->qname);
+                out += '}';
+                return;
+            }
+            case TY_ENUM: {
+                auto ei = cg.EIOf(t);
+                if (seen.insert(ei).second) enums.push_back(ei);
+                out += '{';
+                StringField(out, "enum", ei->en->qname);
+                out += '}';
+                return;
+            }
+            case TY_ARRAY:
+                if (t->arr->akind == A_FIXED) {
+                    out += "{\"array\":{\"elem\":";
+                    Type(out, t->arr->sub);
+                    Append(out, ",\"len\":", cg.ArrSize(t->arr), "}}");
+                    return;
+                }
+                break;
+            case TY_SLICE:
+                out += "{\"slice\":{\"elem\":";
+                Type(out, t->sub);
+                Append(out, ",\"const\":", t->cq ? "true" : "false", "}}");
+                return;
+            case TY_REF:
+                if (IsExportBuilder(t)) {
+                    out += "{\"builder\":{\"elem\":";
+                    Type(out, t->ref->sub->arr->sub);
+                    out += "}}";
+                    return;
+                }
+                out += "{\"ref\":{\"to\":";
+                Type(out, t->ref->sub);
+                Append(out, ",\"const\":", t->cq ? "true" : "false", "}}");
+                return;
+            default:
+                break;
+        }
+        string text;
+        t->Dump(text);
+        out += '{';
+        StringField(out, "other", text);
+        out += '}';
+    }
+
+    void TypedFields(string &out, TypeExpr *t) {
+        out += "\"type\":";
+        Type(out, t);
+        out += ',';
+        string text;
+        t->Dump(text);
+        StringField(out, "text", text);
+    }
+
+    void Fields(string &out, const vector<Field> &fields, const vector<TypeExpr *> &ftypes,
+                const CodeGen::Layout &lo) {
+        out += '[';
+        for (size_t i = 0; i < fields.size(); i++) {
+            if (i) out += ',';
+            auto &f = fields[i];
+            auto off = i < lo.offs.size() ? lo.offs[i] : 0;
+            if (f.ispad || !ftypes[i]) {
+                auto next = i + 1 < lo.offs.size() ? lo.offs[i + 1] : lo.size;
+                Append(out, "{\"pad\":", next - off, ",\"offset\":", off, "}");
+                continue;
+            }
+            out += '{';
+            StringField(out, "name", f.name);
+            out += ',';
+            TypedFields(out, ftypes[i]);
+            Append(out, ",\"offset\":", off, ",\"size\":", cg.FixedSize(ftypes[i]), "}");
+        }
+        out += ']';
+    }
+
+    void Export(string &out, FnSpec *sp) {
+        auto sf = sp->sf;
+        Names(out, sf->name, sf->qname);
+        out += ',';
+        StringField(out, "symbol", sf->cname);
+        out += ',';
+        StringField(out, "doc", sf->doc);
+        out += ",\"params\":[";
+        for (size_t i = 0; i < sp->argtypes.size(); i++) {
+            if (i) out += ',';
+            out += '{';
+            StringField(out, "name", i < sf->params.size() ? sf->params[i].name : string_view("arg"));
+            out += ',';
+            TypedFields(out, sp->argtypes[i]);
+            out += '}';
+        }
+        out += "],\"results\":[";
+        for (size_t i = 0; i < sp->rets.size(); i++) {
+            if (i) out += ',';
+            out += '{';
+            TypedFields(out, sp->rets[i]);
+            out += '}';
+        }
+        out += "]}";
+    }
+
+    void Struct(string &out, StructInst *si) {
+        auto &lo = cg.StructLayout(si);
+        Names(out, si->st->name, si->st->qname);
+        out += ',';
+        StringField(out, "doc", si->st->doc);
+        Append(out, ",\"size\":", lo.size ? lo.size : 1, ",\"align\":", 1, ",\"fields\":");
+        Fields(out, si->st->fields, si->ftypes, lo);
+        out += '}';
+    }
+
+    void Enum(string &out, EnumInst *ei) {
+        int64_t maxp = 0;
+        for (size_t vi = 0; vi < ei->en->variants.size(); vi++)
+            maxp = std::max(maxp, cg.VariantLayout(ei, (int)vi).size);
+        Names(out, ei->en->name, ei->en->qname);
+        out += ',';
+        StringField(out, "doc", ei->en->doc);
+        Append(out, ",\"tag_size\":", cg.TagSize(ei->en), ",\"size\":", cg.TagSize(ei->en) + maxp,
+               ",\"align\":", 1, ",\"variants\":[");
+        for (size_t vi = 0; vi < ei->en->variants.size(); vi++) {
+            if (vi) out += ',';
+            auto &v = ei->en->variants[vi];
+            out += '{';
+            StringField(out, "name", v.name);
+            Append(out, ",\"tag\":", vi, ",\"fields\":");
+            Fields(out, v.fields, ei->vftypes[vi], cg.VariantLayout(ei, (int)vi));
+            out += '}';
+        }
+        out += "]}";
+    }
+
+    string Write(const string &runtime, const string &features) {
+        string out = "{\"format\":1,";
+        StringField(out, "goose_runtime", runtime);
+        out += ',';
+        StringField(out, "features", features);
+        out += ",\"sources\":[";
+        for (size_t i = 0; i < ast.sources.size(); i++) {
+            if (i) out += ',';
+            JsonQuote(out, ast.sources[i].first);
+        }
+        out += "],\"exports\":[";
+        for (size_t i = 0; i < cg.exports.size(); i++) {
+            if (i) out += ',';
+            Export(out, cg.exports[i]);
+        }
+        // Emitting a type can discover more structs or enums, including a
+        // struct first reached through an enum. Drain both queues together.
+        string types, variants;
+        for (size_t s = 0, e = 0; s < structs.size() || e < enums.size();) {
+            if (s < structs.size()) {
+                if (s) types += ',';
+                Struct(types, structs[s++]);
+            } else {
+                if (e) variants += ',';
+                Enum(variants, enums[e++]);
+            }
+        }
+        return cat(out, "],\"structs\":[", types, "],\"enums\":[", variants, "]}\n");
+    }
+};
+
+inline string InterfaceJson(CodeGen &cg, Ast &ast, const string &runtime, const string &features) {
+    InterfaceWriter w { cg, ast, {}, {}, {} };
+    return w.Write(runtime, features);
+}
+
+}  // namespace goose
