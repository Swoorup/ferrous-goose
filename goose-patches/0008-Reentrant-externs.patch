+// The table a call back from C finds export fns in:
+// each one's C symbol, its signature as Goose writes it, its wrapper, and
+// whether a call back may reach it: one that touches no `var` global, so
+// that the code it interrupts, which assumed an extern leaves the globals
+// alone (§7.10), and which may hold references into them, stays right.
+// Whether the specialization, or anything it calls, names a `var` global.
+// `memo` holds the answers so far; a specialization being walked counts as
+// not touching one, which its other paths settle.
+static bool TouchesVarGlobal(FnSpec *sp, map<FnSpec *, bool> &memo) {
+    if (!sp) return false;
+    auto it = memo.find(sp);
+    if (it != memo.end()) return it->second;
+    memo[sp] = false;
+    auto found = false;
+    function<void(Node *)> walk = [&](Node *n) {
+        if (!n || found) return;
+        if (auto id = Is<Ident>(n))
+            if (id->vdef && id->vdef->isglobal && id->vdef->isvar) found = true;
+        if (auto c = Is<Call>(n)) {
+            if (c->builtin < 0 && TouchesVarGlobal(c->spec, memo)) found = true;
+            for (auto d : c->dispatch)
+                if (TouchesVarGlobal(d, memo)) found = true;
+            for (auto &fs : c->fmtspecs)
+                if (TouchesVarGlobal(fs.second, memo)) found = true;
+        }
+        RunChildren(n, walk);
+    };
+    walk(sp->body);
+    memo[sp] = found;
+    return found;
+}
+
+inline void CodeGen::EmitReentryTable() {
+    string rows;
+    int64_t n = 0;
+    map<FnSpec *, bool> touched;
+    for (auto sf : ast.functions) {
+        if (!sf->isexport || sf->specs.size() != 1 || !sinfo.count(sf->specs[0])) continue;
+        auto sp = sf->specs[0];
+        string sig;
+        for (size_t i = 0; i < sp->argtypes.size(); i++) {
+            string t;
+            sp->argtypes[i]->Dump(t);
+            Append(sig, i ? "," : "", t);
+        }
+        sig += "->";
+        for (size_t i = 0; i < sp->rets.size(); i++) {
+            string t;
+            sp->rets[i]->Dump(t);
+            Append(sig, i ? "," : "", t);
+        }
+        auto safe = !TouchesVarGlobal(sp, touched);
+        // Type text holds no quote or backslash to escape.
+        auto esc = cat("\"", sig, "\"");
+        Append(rows, "    { \"", sf->cname, "\", ", esc, ", (void (*)(void))", sf->cname, ", ", safe ? 1 : 0,
+               " },\n");
+        n++;
+    }
+    if (n)
+        Append(code, "static const gs_reentry_entry gs_reentry_table[] = {\n", rows, "};\n"
+                     "static void gs_register_reentry(void) { gs_rt_set_reentry(gs_reentry_table, ", n,
+               "); }\n\n");
+    else
+        Append(code, "static void gs_register_reentry(void) {}\n\n");
 }
 
