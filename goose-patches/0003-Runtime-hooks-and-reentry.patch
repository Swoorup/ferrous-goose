+// Check each exported entry independently. A visited edge stops recursion,
+// but cannot establish that another entry in that cycle is free of globals.
+static bool TouchesVarGlobal(FnSpec *sp, set<FnSpec *> &visited) {
+    if (!sp || !visited.insert(sp).second) return false;
+    auto found = false;
+    function<void(Node *)> walk = [&](Node *n) {
+        if (!n || found) return;
+        if (auto id = Is<Ident>(n))
+            if (id->vdef && id->vdef->isglobal && id->vdef->isvar) found = true;
+        if (auto c = Is<Call>(n)) {
+            if (c->builtin < 0 && TouchesVarGlobal(c->spec, visited)) found = true;
+            for (auto d : c->dispatch)
+                if (TouchesVarGlobal(d, visited)) found = true;
+            for (auto &fs : c->fmtspecs)
+                if (TouchesVarGlobal(fs.second, visited)) found = true;
+        }
+        RunChildren(n, walk);
+    };
+    walk(sp->body);
+    return found;
+}
+
+inline void CodeGen::EmitReentryTable() {
+    if (exports.empty()) return;
+    string rows;
+    for (auto sp : exports) {
+        auto sf = sp->sf;
+        string sig;
+        for (size_t i = 0; i < sp->argtypes.size(); i++) {
+            string t;
+            sp->argtypes[i]->Dump(t);
+            Append(sig, i ? "," : "", t);
+        }
+        sig += "->";
+        for (size_t i = 0; i < sp->rets.size(); i++) {
+            string t;
+            sp->rets[i]->Dump(t);
+            Append(sig, i ? "," : "", t);
+        }
+        set<FnSpec *> visited;
+        auto safe = !TouchesVarGlobal(sp, visited);
+        // Type text holds no quote or backslash to escape.
+        auto esc = cat("\"", sig, "\"");
+        Append(rows, "    { \"", sf->cname, "\", ", esc, ", (void (*)(void))", sf->cname, ", ", safe ? 1 : 0,
+               " },\n");
+    }
+    Append(code, "static const gs_reentry_entry gs_reentry_table[] = {\n", rows, "};\n"
+                 "static void gs_register_reentry(void) { gs_rt_set_reentry(gs_reentry_table, ", exports.size(),
+           "); }\n\n");
 }
 
