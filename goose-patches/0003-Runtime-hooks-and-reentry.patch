--- /dev/null
+++ b/test/native_reentry.py
@@ -0,0 +1,82 @@
+"""Exercise callback eligibility through the public C hooks, including cycles."""
+from pathlib import Path
+import re
+import subprocess
+import sys
+import tempfile
+
+HEADER = '''static const gs_rt_hooks *test_hooks;
+static void test_end(void) { puts("shutdown"); }
+static void test_capture(const gs_rt_hooks *hooks) {
+    test_hooks = hooks;
+    hooks->at_end(test_end);
+}
+int64_t test_invoke(int64_t n) {
+    gs_rt_give_hooks(test_capture);
+    const char *why = NULL;
+    int64_t (*callback)(int64_t) = (int64_t (*)(int64_t))
+        test_hooks->reentry_lookup("target", "i64->i64", &why);
+    return callback ? callback(n) : -999;
+}
+'''
+FIRST = '''export recursive fn first(n: i64) -> i64 {
+    if n > 0 { target(n - 1); }
+    shared += 1;
+    return shared;
+}
+'''
+TARGET = '''export recursive fn target(n: i64) -> i64 {
+    if n > 0 { return first(n - 1); }
+    return 0;
+}
+'''
+SAFE = '''export recursive fn first(n: i64) -> i64 {
+    if n > 0 { return target(n - 1) + 1; }
+    return 0;
+}
+export recursive fn target(n: i64) -> i64 {
+    if n > 0 { return first(n - 1) + 1; }
+    return 0;
+}
+'''
+
+
+def check_native_reentry(exe, base=None):
+    with tempfile.TemporaryDirectory(prefix="native reentry ", dir=base) as tmp:
+        root = Path(tmp)
+        header = root / "callbacks.h"
+        header.write_text(HEADER)
+        cases = [
+            ("unsafe-forward", "var shared: i64 = 0;\n" + FIRST + TARGET, -999, "assert(shared == 0);"),
+            ("unsafe-reverse", "var shared: i64 = 0;\n" + TARGET + FIRST, -999, "assert(shared == 0);"),
+            ("safe-mutual", SAFE, 4, ""),
+            ("safe-self", "export recursive fn target(n: i64) -> i64 { if n > 0 { return target(n - 1) + 1; } return 0; }\n", 4, ""),
+            ("missing", "", -999, ""),
+        ]
+        for opt in ("-O0", "-O2"):
+            for name, exports, expected, extra in cases:
+                source = root / (name + ".goose")
+                source.write_text(exports + 'extern reentrant fn invoke(n: i64) -> i64 = "test_invoke";\n'
+                                  + f'fn main() {{ assert(invoke(4) == {expected}); {extra} print("ok"); }}\n')
+                result = subprocess.run([str(exe), "run", opt, "-q", "--include", str(header), str(source)],
+                                        capture_output=True, text=True, timeout=60)
+                if result.returncode or result.stdout != "ok\nshutdown\n":
+                    raise RuntimeError(f"{name} {opt}: {result.stdout}{result.stderr}")
+            plain = root / "plain.goose"
+            plain.write_text('fn main() { var xs: i64[>..] = []; for i in 4 { xs.push(i * i); } print(xs); }\n')
+            output = root / "plain.c"
+            result = subprocess.run([str(exe), opt, "-q", "-o", str(output), str(plain)],
+                                    capture_output=True, text=True, timeout=60)
+            if result.returncode:
+                raise RuntimeError(result.stdout + result.stderr)
+            generated = output.read_text()
+            assert not re.search(r"\bgs_register_reentry\s*\(", generated)
+            assert "gs_rt_end_hooks();" not in generated
+
+
+if __name__ == "__main__":
+    compiler = Path(sys.argv[1]).resolve()
+    if not compiler.exists():
+        compiler = compiler.with_suffix(".exe")
+    check_native_reentry(compiler)
+    print("native reentry: unsafe cycles rejected, safe recursion and shutdown hooks preserved")
