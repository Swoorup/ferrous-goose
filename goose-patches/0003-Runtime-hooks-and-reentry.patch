+/* The runtime's hooks, which a library that exports
+   `void goose_runtime_hooks(const gs_rt_hooks *)` is handed as the program
+   opens it (spec 7.10): abort_msg ends the program as abort(msg) does, or
+   only the worker in a contained one; at_end has a function called as the
+   program ends. */
+typedef struct {
+    uint32_t version;
+    void (*abort_msg)(const uint8_t *msg, int64_t len, const char *file, int line);
+    void (*at_end)(void (*fn)(void));
+    /* Version 2: the export fn C may call back from a reentrant extern
+       (spec 7.10), by name and signature; and whether this thread runs the
+       main program. */
+    void *(*reentry_lookup)(const char *name, const char *sig, const char **why);
+    int (*on_program_thread)(void);
+} gs_rt_hooks;
+
 /* Appends `count` elements of `size` bytes each to the T[>..] a typed
    builder points at (spec 7.10): the bytes are the elements as Goose lays
    them out, packed, and the header counts elements, not bytes. */
