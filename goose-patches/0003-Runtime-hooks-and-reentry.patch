+/* The functions libraries asked to have called as the program ends
+   (gs_rt_hooks), each once, from the first thread that ends it. */
+static void (*gs_end_fns[16])(void);
+static int gs_nend_fns;
+
+GS_API void gs_at_end(void (*fn)(void)) {
+    if (gs_nend_fns < 16) gs_end_fns[gs_nend_fns++] = fn;
+}
+
+GS_API void gs_rt_end_hooks(void) {
+    while (gs_nend_fns > 0) gs_end_fns[--gs_nend_fns]();
+}
+
+static const gs_reentry_entry *gs_reentry_tab;
+static int64_t gs_reentry_n;
+
+GS_API void gs_rt_set_reentry(const gs_reentry_entry *table, int64_t n) {
+    gs_reentry_tab = table;
+    gs_reentry_n = n;
+}
+
+/* Called from C on the main program's thread only (gs_on_program_thread),
+   so one buffer serves the reasons. */
+static void *gs_reentry_lookup(const char *name, const char *sig, const char **why) {
+    static char reason[512];
+    for (int64_t i = 0; i < gs_reentry_n; i++) {
+        const gs_reentry_entry *e = &gs_reentry_tab[i];
+        if (strcmp(e->name, name)) continue;
+        if (!e->safe) {
+            snprintf(reason, sizeof reason, "export fn %s uses a var global, so it cannot be called "
+                     "back during a call into C", name);
+            if (why) *why = reason;
+            return NULL;
+        }
+        if (strcmp(e->sig, sig)) {
+            snprintf(reason, sizeof reason, "export fn %s is (%s), not (%s)", name, e->sig, sig);
+            if (why) *why = reason;
+            return NULL;
+        }
+        return (void *)e->fn;
+    }
+    snprintf(reason, sizeof reason, "the program has no export fn %s", name);
+    if (why) *why = reason;
+    return NULL;
+}
+
+
 GS_API GS_NORETURN void gs_idxfail(int64_t i, int64_t n, const char *file, int line) {
     gs_failf(file, line, "index %lld out of bounds (length %lld)", (long long)i, (long long)n);
 }
@@ -182,6 +231,16 @@ static char **gs_argv;
 static size_t gs_region_usable, gs_region_gap, gs_region_reserve, gs_region_page;
 /* The worker running on this thread, main's being -1 (runtime_threads.h). */
 static GS_TLS int64_t gs_current_thread_id = -1;
+
+/* Whether the calling thread runs the main program, whose stacks the export
+   wrappers use (gs_rt_hooks). */
+static int gs_on_program_thread(void) { return gs_current_thread_id < 0; }
+
+GS_API void gs_rt_give_hooks(void (*hook)(const gs_rt_hooks *)) {
+    static const gs_rt_hooks hooks = { 2, gs_abort_msg, gs_at_end, gs_reentry_lookup,
+                                       gs_on_program_thread };
+    hook(&hooks);
+}
