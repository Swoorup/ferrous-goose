                                      int line);
 GS_API GS_NORETURN void gs_exit(int64_t code);
+/* What a library an extern block opens may take from the runtime: one that
+   exports goose_runtime_hooks gets them as it is opened (gs_dl_bind), one
+   linked into the program as the program starts. abort_msg ends the program
+   as abort(msg) does, or only the worker in a contained one; at_end has the
+   runtime call a function when the program ends. */
+typedef struct {
+    uint32_t version;
+    void (*abort_msg)(const uint8_t *msg, int64_t len, const char *file, int line);
+    void (*at_end)(void (*fn)(void));
+    /* Version 2: the wrapper of the export fn `name`
+       whose signature is `sig`, for C a reentrant extern runs to call back;
+       NULL, with *why saying why, where there is none it may call. And
+       whether the calling thread runs the main program, whose stacks the
+       export wrappers use. */
+    void *(*reentry_lookup)(const char *name, const char *sig, const char **why);
+    int (*on_program_thread)(void);
+} gs_rt_hooks;
+/* An export fn a call back may reach (gs_register_reentry, generated). */
+typedef struct {
+    const char *name;
+    const char *sig;
+    void (*fn)(void);
+    int safe;
+} gs_reentry_entry;
+GS_API void gs_rt_set_reentry(const gs_reentry_entry *table, int64_t n);
+GS_API void gs_at_end(void (*fn)(void));
+GS_API void gs_rt_give_hooks(void (*hook)(const gs_rt_hooks *));
+GS_API void gs_rt_end_hooks(void);
 GS_API GS_NORETURN void gs_idxfail(int64_t i, int64_t n, const char *file, int line);
 GS_API GS_NORETURN void gs_divfail(const char *file, int line);
 GS_API GS_NORETURN void gs_divovf(const char *file, int line);
