+// Whether an export's parameter is a builder (T[>..]&), which the C
+// wrapper replaces with the runtime's scratch builder for the call.
+static inline bool IsExportBuilder(TypeExpr *t) {
+    return t->kind == TY_REF && t->ref->sub->kind == TY_ARRAY && t->ref->sub->arr->akind == A_GROW;
+}
+
+// The scratch builders exports need: one data stack per builder parameter
+// of the export with the most, each holding one call's elements until the
+// next exported call starts.
+inline int64_t CodeGen::ExportScratchStacks() {
+    int64_t most = 0;
+    for (auto sf : ast.functions) {
+        if (!sf->isexport || sf->specs.size() != 1) continue;
+        int64_t n = 0;
+        for (auto t : sf->specs[0]->argtypes) n += IsExportBuilder(t);
+        most = std::max(most, n);
+    }
+    return most;
+}
+
+// The C wrapper of each export fn (§7.11): its parameters in their C
+// shapes, a builder parameter as the elements and count the call left in a
+// scratch builder (`const T **name, int64_t *name_len`, valid until the next
+// exported call), the first result as the C return value (a `const u8[:]`
+// as a pointer and a trailing `int64_t *` length) and every further result
+// through a trailing out-pointer.
 inline void CodeGen::EmitExports() {
+    auto scratch = ExportScratchStacks();
+    if (scratch)
+        Append(code, "static gs_stack gs_export_scratch[", scratch, "];\n"
+                     "static uint8_t *gs_export_scratch_base[", scratch, "];\n\n");
     for (auto sf : ast.functions) {
         if (!sf->isexport) continue;
         if (sf->specs.size() != 1 || !sinfo.count(sf->specs[0]))
             Fail(sf->line, cat("export fn ", sf->name, " has no emitted specialization"));
         auto sp = sf->specs[0];
         auto &si = sinfo[sp];
-        auto returnslice = !sp->rets.empty() && sp->rets[0]->kind == TY_SLICE;
-        string params, args;
-        vector<string> argv;
+        string body, after;
+        vector<string> argv, pparams, rparams;
+        auto addp = [&](const string &p) { pparams.push_back(p); };
+        int64_t k = 0;
         for (size_t i = 0; i < sp->argtypes.size(); i++) {
+            auto t = sp->argtypes[i];
             auto arg = Unique(cat("gs_export_arg", i));
-            Append(params, params.empty() ? "" : ", ", CT(sp->argtypes[i]), " ", arg);
-            PushArg(argv, sp->argtypes[i], IsPoolParam(sp, i), arg);
+            if (IsExportBuilder(t)) {
+                auto elem = t->ref->sub->arr->sub;
+                auto et = IsU8(elem) ? string("uint8_t") : CT(elem);
+                auto hdr = Unique(cat("gs_export_hdr", i));
+                auto lenp = Unique(cat("gs_export_len", i));
+                addp(cat("const ", et, " **", arg, "_data, int64_t *", lenp));
+                Append(body,
+                       "    if (!gs_export_scratch_base[", k, "]) {\n"
+                       "        gs_stack_init(&gs_export_scratch[", k, "]);\n"
+                       "        gs_export_scratch_base[", k, "] = gs_export_scratch[", k, "].top;\n"
+                       "    }\n"
+                       "    gs_export_scratch[", k, "].top = gs_export_scratch_base[", k, "];\n"
+                       "    gs_rhdr ", hdr, " = { gs_export_scratch_base[", k, "], 0 };\n"
+                       "    gs_rref ", arg, " = { &", hdr, ", &gs_export_scratch[", k, "] };\n");
+                Append(after, "    if (", arg, "_data) *", arg, "_data = (const ", et, " *)", hdr,
+                       ".base;\n    if (", lenp, ") *", lenp, " = ", hdr, ".len;\n");
+                k++;
+            } else {
+                addp(cat(CT(t), " ", arg));
+            }
+            PushArg(argv, t, IsPoolParam(sp, i), arg);
+        }
+        // The results: the C-returned one, and the others through
+        // temporaries the specialization writes (C.3).
+        string ret = "void";
+        vector<string> outs(sp->rets.size());
+        for (size_t r = 0; r < sp->rets.size(); r++) {
+            auto t = sp->rets[r];
+            auto isslice = t->kind == TY_SLICE;
+            if (r == 0) {
+                if (isslice) {
+                    ret = "const uint8_t *";
+                } else {
+                    ret = CT(t);
+                }
+                continue;
+            }
+            auto out = Unique(cat("gs_export_out", r));
+            if (isslice) rparams.push_back(cat("const uint8_t **", out, ", int64_t *", out, "_len"));
+            else rparams.push_back(cat(CT(t), " *", out));
+            outs[r] = out;
         }
-        for (auto &a : argv) Append(args, args.empty() ? "" : ", ", a);
         auto outlen = Unique("gs_export_len");
-        if (returnslice) Append(params, params.empty() ? "" : ", ", "int64_t *", outlen);
+        auto slice0 = !sp->rets.empty() && sp->rets[0]->kind == TY_SLICE;
+        // The parameters, the first result's length, the further results.
+        if (slice0) pparams.push_back(cat("int64_t *", outlen));
+        for (auto &r : rparams) pparams.push_back(r);
+        string params;
+        for (auto &pp : pparams) Append(params, params.empty() ? "" : ", ", pp);
+        vector<string> rettemps(sp->rets.size());
+        for (size_t r = 0; r < sp->rets.size(); r++) {
+            if ((int)r == si.cret) continue;
+            auto tv = Unique(cat("gs_export_ret", r));
+            Append(body, "    ", CT(sp->rets[r]), " ", tv, ";\n");
+            rettemps[r] = tv;
+            argv.push_back(cat("&", tv));
+        }
+        if (si.needssp) argv.push_back("0");
+        string args;
+        for (auto &a : argv) Append(args, args.empty() ? "" : ", ", a);
         if (params.empty()) params = "void";
-        if (!args.empty() && si.needssp) args += ", ";
-        if (si.needssp) args += "0";
-        auto ret = sp->rets.empty() ? string("void")
-                   : returnslice ? string("const uint8_t *") : CT(sp->rets[0]);
         Append(exportprotos, ret, " ", sf->cname, "(", params, ");\n");
         Append(code, ret, " ", sf->cname, "(", params, ") {\n"
                      "    if (!gs_program_initialized)\n"
                      "        gs_panic(\"goose_init must be called before exported functions\");\n");
-        if (returnslice) {
-            auto value = Unique("gs_export_result");
-            Append(code, "    if (!", outlen,
-                   ") gs_panic(\"exported slice length pointer is null\");\n");
-            Append(code, "    ", CT(sp->rets[0]), " ", value, " = ", si.cname, "(", args,
-                   ");\n"
-                   "    *", outlen, " = ", value, ".len;\n"
-                   "    return (const uint8_t *)", value, ".data;\n");
-        } else if (sp->rets.empty()) {
-            Append(code, "    ", si.cname, "(", args, ");\n");
+        if (slice0)
+            Append(code, "    if (!", outlen, ") gs_panic(\"exported slice length pointer is null\");\n");
+        code += body;
+        string r0;
+        if (si.cret >= 0) {
+            r0 = Unique("gs_export_result");
+            Append(code, "    ", CT(sp->rets[si.cret]), " ", r0, " = ", si.cname, "(", args, ");\n");
+            rettemps[si.cret] = r0;
         } else {
-            Append(code, "    return ", si.cname, "(", args, ");\n");
+            Append(code, "    ", si.cname, "(", args, ");\n");
+        }
+        code += after;
+        for (size_t r = 1; r < sp->rets.size(); r++) {
+            auto &o = outs[r];
+            if (sp->rets[r]->kind == TY_SLICE)
+                Append(code, "    if (", o, ") *", o, " = (const uint8_t *)", rettemps[r],
+                       ".data;\n    if (", o, "_len) *", o, "_len = ", rettemps[r], ".len;\n");
+            else
+                Append(code, "    if (", o, ") *", o, " = ", rettemps[r], ";\n");
+        }
+        if (!sp->rets.empty()) {
+            if (slice0)
+                Append(code, "    *", outlen, " = ", rettemps[0], ".len;\n"
+                             "    return (const uint8_t *)", rettemps[0], ".data;\n");
+            else
+                Append(code, "    return ", rettemps[0], ";\n");
         }
         Append(code, "}\n\n");
     }
