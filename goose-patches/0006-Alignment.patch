+    // `align n` where a member may go: an identifier
+    // `align` followed by an integer, which a field named align (followed by
+    // `:`) is not. Sets `*align`, or is an error where none is given (a
+    // variant's fields). True when it was one.
+    bool ParseAlign(int64_t *align, const char *context) {
+        if (lex.tok != T_IDENT || lex.attr != "align") return false;
+        auto save = lex;
+        lex.Next();
+        if (lex.tok != T_INTLIT) {
+            lex = save;
+            return false;
+        }
+        auto n = lex.ival;
+        if (!align) Error(cat("align goes among a struct's fields or an enum's variants, not in a ", context));
+        if (n < 1 || n > 64 || (n & (n - 1)))
+            Error(cat("align ", n, ": the alignment is a power of two from 1 to 64"));
+        if (*align != 1) Error("align is given twice");
+        *align = n;
+        lex.Next();
+        return true;
+    }
+
