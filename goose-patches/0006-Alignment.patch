diff --git a/src/codegen_types.h b/src/codegen_types.h
index e42fd637..c48867d0 100644
--- a/src/codegen_types.h
+++ b/src/codegen_types.h
@@ -240,8 +240,27 @@ inline const char *CodeGen::RelCT(TypeExpr *rt) {
 // StructInst / (EnumInst, variant).
 
 // The alignment `pad` (bare form) gives the next field: its scalar width.
+// The alignment `align n` gives a type's values: its
+// own, or its elements' for a fixed array; 1 for everything else.
+inline int64_t CodeGen::AlignOf(TypeExpr *t) {
+    switch (t->kind) {
+        case TY_STRUCT: return t->struc->st->align;
+        case TY_ENUM: return t->enu->varmode ? 1 : t->enu->en->align;
+        case TY_ARRAY: return t->arr->akind == A_FIXED ? AlignOf(t->arr->sub) : 1;
+        default: return 1;
+    }
+}
+
+// Rounds a data stack's top up to the alignment of the elements about to be
+// placed at it, where they have one.
+inline void CodeGen::AlignTop(const string &stk, TypeExpr *elem) {
+    auto a = AlignOf(elem);
+    if (a > 1) L(TopW(stk), " = GS_ALIGN_UP(", Top(stk), ", ", a, ");");
+}
+
 inline int64_t CodeGen::PadAlign(TypeExpr *t) {
     switch (t->kind) {
+        case TY_STRUCT: case TY_ENUM: return AlignOf(t);
         case TY_INT: return t->intstorage == IS_VARINT ? 1 : IntSize(t->intstorage);
         case TY_FLT: return t->fltstorage == FS_F32 ? 4 : 8;
         case TY_REF: return t->ref->lenstorage >= 0 ?
@@ -280,18 +299,50 @@ inline CodeGen::Layout CodeGen::LayoutFields(const vector<Field> &fields,
     return lo;
 }
 
+// An aligned field must sit at a multiple of its alignment in a container
+// at least as aligned, `base` bytes into it (an enum's payload), and an
+// aligned type's size must be a multiple of its alignment, so that its
+// elements stay aligned too.
+inline void CheckAlignedLayout(CodeGen &cg, string_view what, int64_t align, int64_t base,
+                               const vector<Field> &fields, const vector<TypeExpr *> &ftypes,
+                               const CodeGen::Layout &lo) {
+    for (size_t i = 0; i < fields.size(); i++) {
+        if (fields[i].ispad || !ftypes[i]) continue;
+        auto fa = cg.AlignOf(ftypes[i]);
+        if (fa <= 1) continue;
+        if (align < fa)
+            cg.Fail(fields[i].line, cat(what, ": field ", fields[i].name, " is aligned to ", fa,
+                                        ", which needs `align ", fa, "` (or more) on ", what));
+        if ((base + lo.offs[i]) % fa)
+            cg.Fail(fields[i].line, cat(what, ": field ", fields[i].name, " at offset ", base + lo.offs[i],
+                                        " is not a multiple of its alignment ", fa, ": add a pad before it"));
+    }
+}
+
 inline const CodeGen::Layout &CodeGen::StructLayout(StructInst *si) {
     auto key = pair<const void *, int>(si, -1);
     auto it = layouts.find(key);
     if (it != layouts.end()) return it->second;
-    return layouts[key] = LayoutFields(si->st->fields, si->ftypes);
+    auto &lo = layouts[key] = LayoutFields(si->st->fields, si->ftypes);
+    auto a = si->st->align;
+    CheckAlignedLayout(*this, cat("struct ", si->st->qname), a, 0, si->st->fields, si->ftypes, lo);
+    if (a > 1 && lo.size % a)
+        Fail(si->st->line, cat("struct ", si->st->qname, " has align ", a, " but is ", lo.size,
+                               " bytes: add pad ", a - lo.size % a, " so its elements stay aligned"));
+    if (a > 1 && lo.size > 4096)
+        Fail(si->st->line, cat("struct ", si->st->qname, ": an aligned struct is at most 4096 bytes"));
+    return lo;
 }
 
 inline const CodeGen::Layout &CodeGen::VariantLayout(EnumInst *ei, int vi) {
     auto key = pair<const void *, int>(ei, vi);
     auto it = layouts.find(key);
     if (it != layouts.end()) return it->second;
-    return layouts[key] = LayoutFields(ei->en->variants[vi].fields, ei->vftypes[vi]);
+    auto &lo = layouts[key] = LayoutFields(ei->en->variants[vi].fields, ei->vftypes[vi]);
+    CheckAlignedLayout(*this, cat("enum ", ei->en->qname), ei->en->align,
+                       ei->en->align > 1 ? ei->en->align : 0, ei->en->variants[vi].fields,
+                       ei->vftypes[vi], lo);
+    return lo;
 }
 
