diff --git a/src/native_build.h b/src/native_build.h
new file mode 100644
index 00000000..536f8cb9
--- /dev/null
+++ b/src/native_build.h
@@ -0,0 +1,119 @@
+// Native build providers: an argv command produces a library and optional
+// source modules. The compiler knows the protocol, not the provider's tools.
+#pragma once
+
+namespace goose {
+
+inline bool &NativeBuildsAllowed() { static bool allowed = false; return allowed; }
+inline string &GooseExePath() { static string exe; return exe; }
+
+inline vector<string> NativeStrings(const Json &j, const string &key) {
+    vector<string> out;
+    auto v = j.Get(key);
+    if (!v) return out;
+    if (v->kind != Json::ARRAY) throw CompileError { cat("native build: ", key, " must be a string list") };
+    for (auto &e : v->arr) {
+        if (e.kind != Json::STRING || e.str.empty())
+            throw CompileError { cat("native build: ", key, " must contain nonempty strings") };
+        out.push_back(e.str);
+    }
+    return out;
+}
+
+inline bool NativeHookName(const string &s) {
+    if (s.empty() || !(std::isalpha((unsigned char)s[0]) || s[0] == '_')) return false;
+    for (auto c : s) if (!(std::isalnum((unsigned char)c) || c == '_')) return false;
+    // Keep the runtime's and generated program's symbol namespace private.
+    return !IsCKeyword(s) && s != "main" && s != "goose_init" && s.compare(0, 3, "gs_") != 0;
+}
+
+inline Json NativeBuildReport(const vector<string> &argv, const string &cwd) {
+    auto r = RunProcess(argv, cwd);
+    if (!r.started || r.code != 0)
+        throw CompileError { cat("native build failed in ", cwd, ":\n", r.output) };
+    auto at = r.output.rfind("goose-native: ");
+    if (at == string::npos)
+        throw CompileError { cat("native builder printed no goose-native report:\n", r.output) };
+    auto line = r.output.substr(at + 14);
+    auto j = ParseJson(line.substr(0, line.find('\n')));
+    auto version = j.Get("version");
+    if (j.kind != Json::OBJECT || !version || version->kind != Json::NUMBER || version->num != 1)
+        throw CompileError { "native build report needs protocol version 1" };
+    return j;
+}
+
+inline void ReadNativeLibrary(Package &pkg, const Json &j, const string &cwd) {
+    auto lib = j.Str("staticlib");
+    if (lib.empty()) throw CompileError { "native build report needs a staticlib" };
+    pkg.native_staticlib = IsAbsoluteSource(lib) ? lib : ForwardSlashes(AbsolutePath(cat(cwd, "/", lib)));
+    if (!PathExists(pkg.native_staticlib))
+        throw CompileError { cat("native builder reported a missing library: ", pkg.native_staticlib) };
+    pkg.native_libs = NativeStrings(j, "native_libs");
+    auto hooks = j.Get("runtime_hooks");
+    if (hooks && hooks->kind != Json::STRING)
+        throw CompileError { "native build runtime_hooks must be a public C identifier" };
+    pkg.native_hooks = j.Str("runtime_hooks");
+    if (!pkg.native_hooks.empty() && !NativeHookName(pkg.native_hooks))
+        throw CompileError { "native build runtime_hooks must be a public C identifier" };
+}
+
+inline void BuildNativeLibrary(Package &pkg) {
+    if (pkg.native_build.empty() || !NativeBuildsAllowed()) return;
+    auto cwd = ForwardSlashes(AbsolutePath(pkg.root.empty() ? "." : pkg.root));
+    auto cache = ForwardSlashes(AbsolutePath(cat(GooseHome(), "/build/native/",
+                          pkg.cachekey.empty() ? Hex8(cwd) : pkg.cachekey)));
+    auto includes = cat(cache, "/include");
+    for (auto &rf : runtime_files)
+        if (string_view(rf.name) == "goose.h" && !WriteFileMakingDirs(cat(includes, "/goose.h"), string(rf.text)))
+            throw CompileError { "cannot write the native builder header" };
+    vector<string> argv = pkg.native_build;
+    for (auto &a : vector<string> { "--out-dir", cwd, "--cache-dir", cache,
+                                   "--compiler", GooseExePath(), "--include-dir", includes }) argv.push_back(a);
+    ProgressStep step(cat("building the package ", pkg.name, "'s native library"), true);
+    auto j = NativeBuildReport(argv, cwd);
+    ReadNativeLibrary(pkg, j, cwd);
+    // Providers which need one library for several packages opt into a
+    // combiner. Its command is the group key; each input is opaque to Goose.
+    pkg.native_combine = NativeStrings(j, "combine");
+    pkg.native_input = j.Str("combine_input");
+    if (pkg.native_combine.empty() != pkg.native_input.empty())
+        throw CompileError { "native build needs both combine and combine_input, or neither" };
+    if (!pkg.native_combine.empty()) {
+        auto &exe = pkg.native_combine[0];
+        if (!IsAbsoluteSource(exe) && (exe.find('/') != string::npos || exe.find('\\') != string::npos))
+            exe = ForwardSlashes(AbsolutePath(cat(cwd, "/", exe)));
+    }
+}
+
+inline void CombineNativeLibraries(Ast &ast) {
+    if (!NativeBuildsAllowed()) return;
+    map<vector<string>, vector<int>> groups;
+    for (size_t i = 0; i < ast.packages.size(); i++) {
+        auto &p = ast.packages[i];
+        if (!p.native_combine.empty()) groups[p.native_combine].push_back((int)i);
+    }
+    for (auto &[command, pkgs] : groups) {
+        if (pkgs.size() < 2) continue;
+        string key;
+        for (auto &a : command) Append(key, a.size(), ":", a);
+        for (auto i : pkgs) Append(key, ast.packages[i].native_input.size(), ":", ast.packages[i].native_input);
+        auto cwd = ForwardSlashes(AbsolutePath("."));
+        auto outdir = ForwardSlashes(AbsolutePath(cat(GooseHome(), "/build/native/combined-", Hex8(key))));
+        auto argv = command;
+        argv.push_back("--out-dir"); argv.push_back(outdir);
+        for (auto i : pkgs) {
+            argv.push_back("--input"); argv.push_back(ast.packages[i].native_input);
+        }
+        ProgressStep step(cat("combining ", pkgs.size(), " native libraries"), true);
+        auto j = NativeBuildReport(argv, cwd);
+        ReadNativeLibrary(ast.packages[pkgs[0]], j, cwd);
+        for (size_t k = 1; k < pkgs.size(); k++) {
+            auto &p = ast.packages[pkgs[k]];
+            p.native_owner = pkgs[0];
+            p.native_staticlib.clear();
+            p.native_hooks.clear();
+        }
+    }
+}
+
+}  // namespace goose
