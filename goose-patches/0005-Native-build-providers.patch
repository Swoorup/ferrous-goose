@@ -317,7 +328,8 @@ inline string PackageRoot(const PackageSource &source, const string &name) {
     } else {
         dir = FetchPackage(source, name);
     }
-    if (!PathExists(cat(dir, name, ".goose")))
+    // An external provider may generate the entry as its sidecar loads.
