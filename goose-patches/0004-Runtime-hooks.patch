@@ -113,6 +115,24 @@ GS_API GS_NORETURN void gs_exit(int64_t code) {
     gs_end((int)code);
 }
 
+/* The functions libraries asked to have called as the program ends
+   (gs_rt_hooks), each once, from the first thread that ends it. */
+static void (*gs_end_fns[16])(void);
+static int gs_nend_fns;
+
+GS_API void gs_at_end(void (*fn)(void)) {
+    if (gs_nend_fns < 16) gs_end_fns[gs_nend_fns++] = fn;
+}
+
+GS_API void gs_rt_end_hooks(void) {
+    while (gs_nend_fns > 0) gs_end_fns[--gs_nend_fns]();
+}
+
+GS_API void gs_rt_give_hooks(void (*hook)(const gs_rt_hooks *)) {
+    static const gs_rt_hooks hooks = { 1, gs_abort_msg, gs_at_end };
+    hook(&hooks);
+}
+
