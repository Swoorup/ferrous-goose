+/* Appends count elements of size bytes each to the T[>..] a typed builder
+   points at (spec 7.10): the header counts elements. */
+static void gs_bld_push(gs_rref b, const void *p, int64_t count, int64_t size) {
+    if (count <= 0) return;
+    memcpy(b.stk->top, p, (size_t)(count * size));
+    b.stk->top += count * size;
+    b.hdr->len += count;
+}
+
