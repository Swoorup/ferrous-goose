+/* Appends `count` elements of `size` bytes each to the T[>..] a typed
+   builder points at (spec 7.10): the bytes are the elements as Goose lays
+   them out, packed, and the header counts elements, not bytes. */
+static inline void gs_bld_push(gs_rref b, const void *p, int64_t count, int64_t size) {
