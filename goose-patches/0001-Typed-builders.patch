From 23fad88c91e715301ae554c3b254d6bcde086f38 Mon Sep 17 00:00:00 2001
From: Goose contributors <goose@example.invalid>
Date: Mon, 26 Oct 2026 00:34:21 +1100
Subject: [PATCH] Allow typed builders in the native interface

---
 docs/goose_spec.md    |  5 ++++-
 src/capabilities.h    |  5 +++++
 src/main.cpp          |  2 ++
 src/runtime/goose.h   | 14 +++++++++++++-
 src/runtime_inline.h  | 14 +++++++++++++-
 src/typecheck_calls.h | 16 +++++++++++++---
 test/run_tests.py     |  4 +++-
 7 files changed, 53 insertions(+), 7 deletions(-)
 create mode 100644 src/capabilities.h

diff --git a/docs/goose_spec.md b/docs/goose_spec.md
index eb67619f..659ba347 100644
--- a/docs/goose_spec.md
+++ b/docs/goose_spec.md
@@ -2895,7 +2895,10 @@ limited arrays, and fixed-mode ADTs), by value as its packed C type;
 (`{ data, len }`); and `u8[>..]&`, as the resizable's header plus its stack
 (`gs_rref`), which C appends to through `gs_bld_append(ref, p, n)`; C
 compiled on its own, a package's, finds both in `goose.h`
-(docs/packages.md).
+(docs/packages.md). A typed builder, `T[>..]&` of such a `T`, crosses the
+same way: C appends whole elements, laid out as Goose lays them out, at the
+stack's top and counts them in the header's `len`, which
+`gs_bld_push(ref, p, count, size)` does.
 Returns are one scalar or flat fixed-size value by value, or nothing;
 references, slices and builders are parameter-only forms. Everything
 else — varints, references inside structs, variable and resizable values
diff --git a/src/capabilities.h b/src/capabilities.h
new file mode 100644
index 00000000..30575035
--- /dev/null
+++ b/src/capabilities.h
@@ -0,0 +1,5 @@
+// Native interface capabilities reported by `goose version`.
+#pragma once
+
+#define GOOSE_NATIVE_ABI 1
+#define GOOSE_FEATURES "typed-builders"
