    parameter arrives as a gs_rref, the resizable's header and its data
    stack, and C appends to it with gs_bld_append; the stack's top is where
-   the bytes go, and nothing else of it is C's to touch.
+   the bytes go, and nothing else of it is C's to touch. A typed builder,
+   `T[>..]&` of a flat fixed-size T, arrives the same way, and C appends
+   whole elements with gs_bld_push.
 
    The compiler writes this header beside every native part it builds and
    puts it on that part's include path, `#include "goose.h"`, and builds
@@ -4429,6 +4431,16 @@ static inline void gs_bld_append(gs_rref b, const void *p, int64_t n) {
     b.hdr->len += n;
 }
 
+/* Appends `count` elements of `size` bytes each to the T[>..] a typed
+   builder points at (spec 7.10): the bytes are the elements as Goose lays
+   them out, packed, and the header counts elements, not bytes. */
+static inline void gs_bld_push(gs_rref b, const void *p, int64_t count, int64_t size) {
+    if (count <= 0) return;
+    memcpy(b.stk->top, p, (size_t)(count * size));
+    b.stk->top += count * size;
+    b.hdr->len += count;
+}
+
 #endif
 )GSRT"
     ) },
diff --git a/src/typecheck_calls.h b/src/typecheck_calls.h
index 4c58d0ca..274a23a2 100644
--- a/src/typecheck_calls.h
+++ b/src/typecheck_calls.h
@@ -2553,7 +2553,15 @@ inline bool TypeCheck::ExternParamOk(TypeExpr *t, string &why) {
             return false;
         }
         auto s = t->ref->sub;
-        if (s->kind == TY_ARRAY && s->arr->akind == A_GROW && IsU8(s->arr->sub)) return true;
+        // A builder (T[>..]&) of a flat fixed-size T: C appends whole
+        // elements at its stack's top and counts them in its header.
+        if (s->kind == TY_ARRAY && s->arr->akind == A_GROW) {
+            if (IsU8(s->arr->sub)) return true;
+            string ewhy;
+            if (ExternValueOk(s->arr->sub, ewhy)) return true;
+            why = cat("a builder's elements must be flat fixed-size values: ", ewhy);
+            return false;
+        }
         return ExternValueOk(s, why);
     }
     if (t->kind == TY_SLICE) return ExternValueOk(t->sub, why);
@@ -2700,9 +2708,11 @@ inline void TypeCheck::CheckExport(SFunction *sf) {
             fail(cat("parameter ", sf->params[i].name,
                      " uses a reusable pool and has no public C representation"));
         if (t->kind == TY_REF && t->ref->sub->kind == TY_ARRAY &&
-            t->ref->sub->arr->akind == A_GROW && IsU8(t->ref->sub->arr->sub))
+            t->ref->sub->arr->akind == A_GROW)
             fail(cat("parameter ", sf->params[i].name,
-                     " is a Goose string builder and cannot be passed from C"));
+                     IsU8(t->ref->sub->arr->sub) ? " is a Goose string builder"
+                                                 : " is a Goose builder",
+                     " and cannot be passed from C"));
     }
     if (spec->rets.size() > 1) fail("returns at most one value");
     if (!sf->has_rets && !spec->rets.empty())
