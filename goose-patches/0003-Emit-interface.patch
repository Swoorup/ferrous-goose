         if (stacks) cg.StackReport(msgs, stackcfg);
+        // The C interface as JSON: to stdout for `json` or `-`, else the
+        // file named (interface.h).
+        if (!interfacename.empty()) {
+            auto text = InterfaceJson(cg, ast, RuntimeVersion(), GOOSE_FEATURES);
+            if (interfacename == "json" || interfacename == "-") {
+                fwrite(text.data(), 1, text.size(), stdout);
+            } else {
+                if (!WriteFileMakingDirs(interfacename, text))
+                    throw CompileError { cat("cannot write the interface: ", interfacename) };
+                fprintf(msgs, "wrote %s (%d bytes)\n", interfacename.c_str(), (int)text.size());
+            }
+            if (nocgen) return 0;
+        }
         // The packages whose native parts the program needs, which a JIT
         // run takes functions from and a build links: its own, when it has
         // one, and every package an extern fn it calls was declared in,
