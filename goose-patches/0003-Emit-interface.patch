diff --git a/src/interface.h b/src/interface.h
new file mode 100644
index 00000000..7890a0cf
--- /dev/null
+++ b/src/interface.h
@@ -0,0 +1,221 @@
+// Goose compiler — the program's C interface as JSON (`--emit-interface`):
+// its export fns with their parameters and results, and the layout of
+// every struct and enum they reach, as the C backend lays them out (C.2).
+// What a binding generator in another language  builds its side from, and what it checks a
+// binding it wrote against. Written by the backend, which owns the layouts;
+// `goose check --emit-interface` runs it for that and writes nothing else.
+#pragma once
+
+namespace goose {
+
+struct InterfaceWriter {
+    CodeGen &cg;
+    Ast &ast;
+    string out;
+    vector<StructInst *> structs;
+    vector<EnumInst *> enums;
+    set<const void *> seen;
+
+    void Type(TypeExpr *t) {
+        switch (t->kind) {
+            case TY_INT:
+                Append(out, "{\"prim\":\"", IntStorageName(t->intstorage), "\"}");
+                return;
+            case TY_FLT:
+                Append(out, "{\"prim\":\"", t->fltstorage == FS_F32 ? "f32" : "f64", "\"}");
+                return;
+            case TY_BOOL:
+                out += "{\"prim\":\"bool\"}";
+                return;
+            case TY_STRUCT: {
+                auto si = cg.SI(t);
+                if (seen.insert(si).second) structs.push_back(si);
+                out += "{\"struct\":";
+                JsonQuote(out, si->st->qname);
+                out += "}";
+                return;
+            }
+            case TY_ENUM: {
+                auto ei = cg.EIOf(t);
+                if (seen.insert(ei).second) enums.push_back(ei);
+                out += "{\"enum\":";
+                JsonQuote(out, ei->en->qname);
+                out += "}";
+                return;
+            }
+            case TY_ARRAY:
+                if (t->arr->akind == A_FIXED) {
+                    out += "{\"array\":{\"elem\":";
+                    Type(t->arr->sub);
+                    Append(out, ",\"len\":", cg.ArrSize(t->arr), "}}");
+                    return;
+                }
+                break;
+            case TY_SLICE:
+                out += "{\"slice\":{\"elem\":";
+                Type(t->sub);
+                Append(out, ",\"const\":", t->cq ? "true" : "false", "}}");
+                return;
+            case TY_REF:
+                if (t->ref->sub->kind == TY_ARRAY && t->ref->sub->arr->akind == A_GROW) {
+                    out += "{\"builder\":{\"elem\":";
+                    Type(t->ref->sub->arr->sub);
+                    out += "}}";
+                    return;
+                }
+                out += "{\"ref\":{\"to\":";
+                Type(t->ref->sub);
+                Append(out, ",\"const\":", t->cq ? "true" : "false", "}}");
+                return;
+            default:
+                break;
+        }
+        string s;
+        t->Dump(s);
+        out += "{\"other\":";
+        JsonQuote(out, s);
+        out += "}";
+    }
+
+    void Text(TypeExpr *t) {
+        string s;
+        t->Dump(s);
+        JsonQuote(out, s);
+    }
+
+    void Fields(const vector<Field> &fields, const vector<TypeExpr *> &ftypes,
+                const CodeGen::Layout &lo) {
+        out += "[";
+        auto first = true;
+        for (size_t i = 0; i < fields.size(); i++) {
+            auto &f = fields[i];
+            if (!first) out += ",";
+            first = false;
+            auto off = i < lo.offs.size() ? lo.offs[i] : 0;
+            if (f.ispad || !ftypes[i]) {
+                auto next = i + 1 < lo.offs.size() ? lo.offs[i + 1] : lo.size;
+                Append(out, "{\"pad\":", next - off, ",\"offset\":", off, "}");
+                continue;
+            }
+            out += "{\"name\":";
+            JsonQuote(out, f.name);
+            out += ",\"type\":";
+            Type(ftypes[i]);
+            out += ",\"text\":";
+            Text(ftypes[i]);
+            Append(out, ",\"offset\":", off, ",\"size\":", cg.FixedSize(ftypes[i]), "}");
+        }
+        out += "]";
+    }
+
+    string Write(const string &runtime, const string &features) {
+        out = "{\"format\":1,\"goose_runtime\":";
+        JsonQuote(out, runtime);
+        out += ",\"features\":";
+        JsonQuote(out, features);
+        out += ",\"sources\":[";
+        for (size_t i = 0; i < ast.sources.size(); i++) {
+            if (i) out += ",";
+            JsonQuote(out, ast.sources[i].first);
+        }
+        out += "],\"exports\":[";
+        auto first = true;
+        for (auto sf : ast.functions) {
+            if (!sf->isexport || sf->specs.size() != 1) continue;
+            auto sp = sf->specs[0];
+            if (!first) out += ",";
+            first = false;
+            out += "{\"name\":";
+            JsonQuote(out, sf->name);
+            out += ",\"qname\":";
+            JsonQuote(out, sf->qname);
+            out += ",\"symbol\":";
+            JsonQuote(out, sf->cname);
+            out += ",\"doc\":";
+            JsonQuote(out, sf->doc);
+            out += ",\"params\":[";
+            for (size_t i = 0; i < sp->argtypes.size(); i++) {
+                if (i) out += ",";
+                out += "{\"name\":";
+                JsonQuote(out, i < sf->params.size() ? sf->params[i].name : string_view("arg"));
+                out += ",\"type\":";
+                Type(sp->argtypes[i]);
+                out += ",\"text\":";
+                Text(sp->argtypes[i]);
+                out += "}";
+            }
+            out += "],\"results\":[";
+            for (size_t i = 0; i < sp->rets.size(); i++) {
+                if (i) out += ",";
+                out += "{\"type\":";
+                Type(sp->rets[i]);
+                out += ",\"text\":";
+                Text(sp->rets[i]);
+                out += "}";
+            }
+            out += "]}";
+        }
+        // The types the exports reach, and the ones those reach.
+        string types = "],\"structs\":[";
+        string enumtext = "],\"enums\":[";
+        for (size_t k = 0, e = 0; k < structs.size() || e < enums.size();) {
+            if (k < structs.size()) {
+                auto si = structs[k++];
+                auto save = std::move(out);
+                out.clear();
+                auto &lo = cg.StructLayout(si);
+                out += "{\"name\":";
+                JsonQuote(out, si->st->name);
+                out += ",\"qname\":";
+                JsonQuote(out, si->st->qname);
+                out += ",\"doc\":";
+                JsonQuote(out, si->st->doc);
+                Append(out, ",\"size\":", lo.size ? lo.size : 1, ",\"fields\":");
+                Fields(si->st->fields, si->ftypes, lo);
+                out += "}";
+                if (types.back() != '[') types += ",";
+                types += out;
+                out = std::move(save);
+                continue;
+            }
+            auto ei = enums[e++];
+            auto save = std::move(out);
+            out.clear();
+            int64_t maxp = 0;
+            for (size_t vi = 0; vi < ei->en->variants.size(); vi++)
+                maxp = std::max(maxp, cg.VariantLayout(ei, (int)vi).size);
+            out += "{\"name\":";
+            JsonQuote(out, ei->en->name);
+            out += ",\"qname\":";
+            JsonQuote(out, ei->en->qname);
+            out += ",\"doc\":";
+            JsonQuote(out, ei->en->doc);
+            Append(out, ",\"tag_size\":", cg.TagSize(ei->en), ",\"size\":", cg.TagSize(ei->en) + maxp,
+                   ",\"variants\":[");
+            for (size_t vi = 0; vi < ei->en->variants.size(); vi++) {
+                if (vi) out += ",";
+                auto &v = ei->en->variants[vi];
+                out += "{\"name\":";
+                JsonQuote(out, v.name);
+                Append(out, ",\"tag\":", vi, ",\"fields\":");
+                Fields(v.fields, ei->vftypes[vi], cg.VariantLayout(ei, (int)vi));
+                out += "}";
+            }
+            out += "]}";
+            if (enumtext.back() != '[') enumtext += ",";
+            enumtext += out;
+            out = std::move(save);
+        }
+        out += types;
+        out += enumtext;
+        out += "]}\n";
+        return out;
+    }
+};
+
+inline string InterfaceJson(CodeGen &cg, Ast &ast, const string &runtime, const string &features) {
+    InterfaceWriter w { cg, ast, {}, {}, {}, {} };
+    return w.Write(runtime, features);
+}
+
+}  // namespace goose
